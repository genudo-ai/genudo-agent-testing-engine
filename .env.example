# ==============================================================================
# GenuDo Agent Automated Testing Engine - configuration
# Copy to .env (gitignored) and fill in. Real environment variables take precedence.
# ==============================================================================

# GenuDo API bearer token. The SAME token is used for {GENUDO_BASE}/mcp (MCP tools)
# and {GENUDO_BASE}/api/user/* (REST: create test opportunities, send test messages,
# pause conversations). Create it in the console: Developer > API Keys & Tokens, with
# mcp:use plus the opportunity, conversation and message write scopes.
GENUDO_TOKEN=your_genudo_bearer_token_here

# API base URL
GENUDO_BASE=https://api.genudo.ai

# Channel -> pipeline id map: channel=<numeric id>,channel=<numeric id>
# Point these at a STAGING / TEST pipeline first, never straight at production.
GENUDO_PIPELINES=messenger=YOUR_PIPELINE_ID

# 'dev' (default) or 'prod'. With 'prod' the engine refuses to run unless --allow-prod is passed.
GENUDO_ENV=dev

# Name of the stage test opportunities are moved to at the end of a run.
# It MUST exist in every pipeline you test (create it in the GenuDo pipeline settings).
GENUDO_ARCHIVED_STAGE=Archived

# MCP request budget per minute (the engine never goes faster than one call every 2.2s)
GENUDO_MCP_MAX_RPM=30

# LLM judge (Tier 2). Runs through your local AI subscription CLI - no API keys.
#   claude = `claude -p --model haiku` (Claude Code subscription)
#   codex  = `codex exec` (ChatGPT subscription via Codex CLI)
#   off    = deterministic checks only
# Leave empty to auto-detect (claude, then codex, else off).
GENUDO_JUDGE=
# Optional model override for the judge CLI (claude default: haiku; codex default: CLI default)
GENUDO_JUDGE_MODEL=
